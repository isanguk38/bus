# 공공데이터포털(data.go.kr) 일반 인증키 — 신청한 모든 API에 공통 적용
DATA_GO_KR_SERVICE_KEY=your_service_key_here

# ── 전국: 국토교통부 TAGO ──
TAGO_BUS_LOCATION_URL=https://apis.data.go.kr/1613000/BusLcInfoInqireService
TAGO_BUS_ROUTE_URL=https://apis.data.go.kr/1613000/BusRouteInfoInqireService

# ── 서울특별시 ──
SEOUL_BUS_POSITION_URL=http://ws.bus.go.kr/api/rest/buspos
SEOUL_BUS_ROUTE_URL=http://ws.bus.go.kr/api/rest/busRouteInfo

# ── 경기도 ──
GYEONGGI_BUS_LOCATION_URL=https://apis.data.go.kr/6410000/buslocationservice/v2

# ── 정류장 / 도착 정보 ──
TAGO_BUS_STOP_URL=https://apis.data.go.kr/1613000/BusSttnInfoInqireService
TAGO_BUS_ARRIVAL_URL=https://apis.data.go.kr/1613000/ArvlInfoInqireService
SEOUL_BUS_STATION_URL=http://ws.bus.go.kr/api/rest/stationinfo

# ── 선택: 브이월드(국토교통부) 배경지도 + 장소·주소 검색 ──
# https://www.vworld.kr 에서 무료 발급. 비워두면 OpenStreetMap 지도 + 정류장 이름 검색만 사용
VWORLD_API_KEY=
# 키를 발급받을 때 등록한 서비스 URL (예: bus-live-map.onrender.com)
VWORLD_DOMAIN=
